{
  "name": "omdsh-desktop-workspace",
  "description": "Workspace root for the DeepSeek Harness desktop application: the Electron shell and the packaging pipeline.",
  "version": "0.1.0-rc.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-plugins/omdsh-desktop.git"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json && pnpm --filter @omdsh-plugins/omdsh-desktop exec tsdown",
    "typecheck": "tsc --build tsconfig.json --force && tsc --noEmit -p tsconfig.checks.json",
    "test": "vitest run",
    "package:desktop": "tsx scripts/package-desktop-app.ts",
    "harness:local": "tsx scripts/harness-source.ts --local",
    "harness:npm": "tsx scripts/harness-source.ts --npm",
    "harness:latest": "tsx scripts/harness-source.ts --latest",
    "check:harness-outdated": "tsx scripts/harness-source.ts --outdated",
    "check:harness-pin": "tsx scripts/harness-source.ts --check",
    "plugins:local": "tsx scripts/plugin-source.ts --local",
    "plugins:npm": "tsx scripts/plugin-source.ts --npm",
    "plugins:latest": "tsx scripts/plugin-source.ts --latest",
    "plugins:none": "tsx scripts/plugin-source.ts --none",
    "check:plugin-outdated": "tsx scripts/plugin-source.ts --outdated",
    "check:plugin-pin": "tsx scripts/plugin-source.ts --check",
    "clean": "rm -rf app/lib dist-desktop *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.20.0",
    "jsdom": "29.1.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
